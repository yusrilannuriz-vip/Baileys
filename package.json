  "scripts": {
    "lint": "node -e \"const { execFileSync } = require('child_process'); const fs=require('fs'); const path=require('path'); const walk=d=>fs.readdirSync(d,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(path.join(d,e.name)):[path.join(d,e.name)]); for (const f of walk('lib').filter(f=>f.endsWith('.js'))) execFileSync(process.execPath,['--check',f],{stdio:'inherit'}); execFileSync(process.execPath,['--check','WAProto/index.js'],{stdio:'inherit'}); console.log('LINT_OK')\"",
    "test": "npm run lint",
    "preinstall": "node ./engine-requirements.js"
  },
